# Optional, local-dev only. LemonBeam is bring-your-own-key (BYOK): the
# OpenAI API key normally comes from each scan request, not this file.
# Set this only if you want a fallback so you don't have to paste a key
# into the UI on every local test run. Do not rely on this in production.
OPENAI_API_KEY=your-openai-api-key-here

PORT=3000