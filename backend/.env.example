# Optional, local-dev only. LemonBeam is bring-your-own-key (BYOK): the
# OpenRouter API key normally comes from each scan request, not this file.
# Set this only if you want a fallback so you don't have to paste a key
# into the UI on every local test run. Do not rely on this in production.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Required for real use (not BYOK — this is a normal shared server
# credential, unlike the OpenRouter key above). Raises GitHub's REST API rate
# limit from 60/hr to 5,000/hr for repository-validation calls. Only ever
# reads public data. See DECISIONS.md > "GitHub Access Uses a Personal
# Access Token for Validation Calls".
GITHUB_TOKEN=your-github-personal-access-token-here

PORT=3000